# App URLs
CLIENT_URL=http://localhost:3000
# Canonical public origin for sitemap / robots / llms.txt / JSON-LD
SITE_URL=https://filterhero.net
# Client-side OG/canonical (baked in at `vite build`)
VITE_SITE_URL=https://filterhero.net
PORT=3001
NODE_ENV=development

# Persistent JSON for leads + orders (defaults to <cwd>/server/data)
# DATA_DIR=./server/data

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — default txcd_99999999 General Tangible Goods (see docs/STRIPE-BOOKS.md)
# STRIPE_TAX_CODE=txcd_99999999
# Checkout is a Stripe-hosted redirect. Publishable keys are unused until
# embedded checkout is added — do not put sk_ secrets in VITE_ vars.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Contact / lead gen
CONTACT_TO=info@filterhero.net
RESEND_API_KEY=
RESEND_FROM=Filter Hero <info@filterhero.net>

# Klaviyo (marketing). Private key is server-only — never prefix with VITE_.
# KLAVIYO_PRIVATE_API_KEY=pk_...
# KLAVIYO_PUBLIC_API_KEY=VnVNmQ
# KLAVIYO_LIST_ID=RiTKiS
# KLAVIYO_DISABLE=1

# Cloudflare Turnstile (bot check on /api/contact)
# TURNSTILE_SECRET_KEY=0x...
# VITE_TURNSTILE_SITE_KEY=0x...
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Catalog: false = Model Pricing XLS checkout. Finder still quotes off-XLS sizes.
# VITE_ prefix is required for the client bundle; FULL_CATALOG covers the API.
VITE_FULL_CATALOG=false
FULL_CATALOG=false

# Filter King reseller API (server only — never VITE_)
# FILTERKING_CLIENT_ID=
# FILTERKING_CLIENT_SECRET=
# FILTERKING_API_BASE=https://filterking.com

# CRM + customer accounts — Supabase project "filter-hero".
# See docs/CRM.md and docs/CUSTOMER-ACCOUNTS.md.
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings → API → service_role. Server only. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# JWT anon key — server uses this to verify sessions (getUser).
SUPABASE_ANON_KEY=
# Comma-separated staff logins allowed into /admin
STAFF_EMAILS=info@filterhero.net
# CRM_DISABLE=1
# ACCOUNT_DISABLE=1

# QuickBooks Online (Intuit) OAuth — server only. Never prefix with VITE_.
# Local: Development keys + sandbox + localhost callback.
# Live Railway: pnpm setup:intuit-live (uses INTUIT_PRODUCTION_* from .env).
# INTUIT_CLIENT_ID=
# INTUIT_CLIENT_SECRET=
# INTUIT_ENVIRONMENT=sandbox
# INTUIT_REDIRECT_URI=http://localhost:3001/api/intuit/oauth/callback
# INTUIT_PRODUCTION_CLIENT_ID=
# INTUIT_PRODUCTION_CLIENT_SECRET=

# Constant Contact V3 (server only). Never prefix with VITE_.
# API key is the client id. Generate the secret once on My Applications.
# CONSTANT_CONTACT_CLIENT_ID=
# CONSTANT_CONTACT_CLIENT_SECRET=
# CONSTANT_CONTACT_REDIRECT_URI=https://filterhero.net/api/constant-contact/oauth/callback
